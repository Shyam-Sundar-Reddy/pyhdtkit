@prefix core: <http://example.org/core/> .
@prefix kf: <http://example.org/kafka/> .


kf:broker_3_2 a kf:Broker ;
    kf:rack "rack-32" .

kf:topic_3_2_0 a kf:Topic ;
    kf:name "ledger.events.v320" ;
    kf:partitions "3" ;
    kf:replicationFactor "2" ;
    kf:hostedOn kf:broker_3_2 ;
    kf:producedBy core:svc_ledger ;
    kf:consumedBy core:svc_notify .

kf:topic_3_2_1 a kf:Topic ;
    kf:name "notify.events.v321" ;
    kf:partitions "6" ;
    kf:replicationFactor "3" ;
    kf:hostedOn kf:broker_3_2 ;
    kf:producedBy core:svc_notify ;
    kf:consumedBy core:svc_audit .

kf:topic_3_2_2 a kf:Topic ;
    kf:name "audit.events.v322" ;
    kf:partitions "9" ;
    kf:replicationFactor "2" ;
    kf:hostedOn kf:broker_3_2 ;
    kf:producedBy core:svc_audit ;
    kf:consumedBy core:svc_orders .

kf:topic_3_2_3 a kf:Topic ;
    kf:name "orders.events.v323" ;
    kf:partitions "12" ;
    kf:replicationFactor "3" ;
    kf:hostedOn kf:broker_3_2 ;
    kf:producedBy core:svc_orders ;
    kf:consumedBy core:svc_billing .

kf:topic_3_2_4 a kf:Topic ;
    kf:name "billing.events.v324" ;
    kf:partitions "3" ;
    kf:replicationFactor "2" ;
    kf:hostedOn kf:broker_3_2 ;
    kf:producedBy core:svc_billing ;
    kf:consumedBy core:svc_payments .

kf:topic_3_2_5 a kf:Topic ;
    kf:name "payments.events.v325" ;
    kf:partitions "6" ;
    kf:replicationFactor "3" ;
    kf:hostedOn kf:broker_3_2 ;
    kf:producedBy core:svc_payments ;
    kf:consumedBy core:svc_ledger .

kf:topic_3_2_6 a kf:Topic ;
    kf:name "ledger.events.v326" ;
    kf:partitions "9" ;
    kf:replicationFactor "2" ;
    kf:hostedOn kf:broker_3_2 ;
    kf:producedBy core:svc_ledger ;
    kf:consumedBy core:svc_notify .

kf:topic_3_2_7 a kf:Topic ;
    kf:name "notify.events.v327" ;
    kf:partitions "12" ;
    kf:replicationFactor "3" ;
    kf:hostedOn kf:broker_3_2 ;
    kf:producedBy core:svc_notify ;
    kf:consumedBy core:svc_audit .
