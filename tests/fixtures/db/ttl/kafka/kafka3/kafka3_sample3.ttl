@prefix core: <http://example.org/core/> .
@prefix kf: <http://example.org/kafka/> .


kf:broker_3_3 a kf:Broker ;
    kf:rack "rack-33" .

kf:topic_3_3_0 a kf:Topic ;
    kf:name "ledger.events.v330" ;
    kf:partitions "3" ;
    kf:replicationFactor "2" ;
    kf:hostedOn kf:broker_3_3 ;
    kf:producedBy core:svc_ledger ;
    kf:consumedBy core:svc_audit .

kf:topic_3_3_1 a kf:Topic ;
    kf:name "notify.events.v331" ;
    kf:partitions "6" ;
    kf:replicationFactor "3" ;
